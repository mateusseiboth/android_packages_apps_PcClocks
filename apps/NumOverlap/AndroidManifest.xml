<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.systemui.clocks.numoverlap">

    <uses-permission android:name="com.android.systemui.permission.PLUGIN" />

    <application android:label="@string/clock_numoverlap_name">
        <service
            android:name="org.lineageos.pcclocks.NumOverlapClockProvider"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.systemui.action.PLUGIN_CLOCK_PROVIDER" />
            </intent-filter>
        </service>
    </application>
</manifest>
